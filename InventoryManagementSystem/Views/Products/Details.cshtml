@model Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="panel p-4 mb-4" style="max-width:560px">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h4 class="mb-1">@Model.ProductName</h4>
            <p class="text-muted mb-0">SKU: @Model.SKU</p>
        </div>
        @if (Model.StockQuantity <= Model.LowStockThreshold)
        {
            <span class="badge badge-soft-danger">Low Stock</span>
        }
    </div>

    <hr />

    <div class="row g-3">
        <div class="col-6">
            <div class="text-muted small">Category</div>
            <div>@Model.Category.CategoryName</div>
        </div>
        <div class="col-6">
            <div class="text-muted small">Unit Price</div>
            <div>@Model.UnitPrice.ToString("N2")</div>
        </div>
        <div class="col-6">
            <div class="text-muted small">Current Stock</div>
            <div>@Model.StockQuantity</div>
        </div>
        <div class="col-6">
            <div class="text-muted small">Low Stock Threshold</div>
            <div>@Model.LowStockThreshold</div>
        </div>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-accent">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>