@model List<Product>
@{
    ViewData["Title"] = "Products";
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <label for="searchInput" class="visually-hidden">Search products</label>
        <input id="searchInput" type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name or SKU..." aria-label="Search by product name or SKU" />
    </div>
    <div class="col-md-3">
        <label for="categorySelect" class="visually-hidden">Filter by category</label>
        <select id="categorySelect" name="categoryId" class="form-select" aria-label="Filter by category">
            <option value="">All Categories</option>
            @foreach (var c in (List<Category>)ViewBag.Categories)
            {
                <option value="@c.CategoryId" selected="@(ViewBag.CurrentCategory == c.CategoryId ? "selected" : null)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="statusSelect" class="visually-hidden">Filter by stock status</label>
        <select id="statusSelect" name="status" class="form-select" aria-label="Filter by stock status">
            <option value="">All Statuses</option>
            <option value="InStock" selected="@(ViewBag.CurrentStatus == "InStock" ? "selected" : null)">In Stock</option>
            <option value="LowStock" selected="@(ViewBag.CurrentStatus == "LowStock" ? "selected" : null)">Low Stock</option>
            <option value="OutOfStock" selected="@(ViewBag.CurrentStatus == "OutOfStock" ? "selected" : null)">Out of Stock</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-accent w-100">Filter</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
    <a asp-action="Create" class="btn btn-accent">+ Add Product</a>
</div>

<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            @(ViewBag.HasActiveFilters ? "No products match your search." : "No products added yet.")
        </div>
    }
    else
    {
        <table class="table-clean">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    string statusLabel;
                    string badgeClass;
                    if (p.StockQuantity == 0)
                    {
                        statusLabel = "Out of Stock";
                        badgeClass = "badge-soft-danger";
                    }
                    else if (p.StockQuantity <= p.LowStockThreshold)
                    {
                        statusLabel = "Low Stock";
                        badgeClass = "badge-soft-warn";
                    }
                    else
                    {
                        statusLabel = "In Stock";
                        badgeClass = "badge-soft-accent";
                    }

                    <tr>
                        <td>@p.ProductName</td>
                        <td class="text-muted">@p.SKU</td>
                        <td>@p.Category.CategoryName</td>
                        <td>@p.UnitPrice.ToString("N2")</td>
                        <td>@p.StockQuantity</td>
                        <td><span class="badge @badgeClass">@statusLabel</span></td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-accent">Edit</a>
                            <a asp-action="Delete" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-search="@ViewBag.CurrentSearch"
                   asp-route-categoryId="@ViewBag.CurrentCategory"
                   asp-route-status="@ViewBag.CurrentStatus"
                   asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
            </li>

            @{
                int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
            }

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory" asp-route-status="@ViewBag.CurrentStatus" asp-route-page="1">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-search="@ViewBag.CurrentSearch"
                       asp-route-categoryId="@ViewBag.CurrentCategory"
                       asp-route-status="@ViewBag.CurrentStatus"
                       asp-route-page="@i">@i</a>
                </li>
            }

            @if (endPage < ViewBag.TotalPages)
            {
                @if (endPage < ViewBag.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.CurrentSearch" asp-route-categoryId="@ViewBag.CurrentCategory" asp-route-status="@ViewBag.CurrentStatus" asp-route-page="@ViewBag.TotalPages">@ViewBag.TotalPages</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-search="@ViewBag.CurrentSearch"
                   asp-route-categoryId="@ViewBag.CurrentCategory"
                   asp-route-status="@ViewBag.CurrentStatus"
                   asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}