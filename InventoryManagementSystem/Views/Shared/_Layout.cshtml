@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string> isActive = name => currentController == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">Inventory<span>Sys</span></a>
            <nav>
                <a asp-controller="Home" asp-action="Index" class="@isActive("Home")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v9a1 1 0 0 0 1 1h4v-6h3v6h4a1 1 0 0 0 1-1v-9" /></svg>
                    </span>
                    <span class="sidebar-label">Home</span>
                </a>
                <a asp-controller="Dashboard" asp-action="Index" class="@isActive("Dashboard")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20V11M10 20V4M16 20v-6" stroke-linecap="round" /><path d="M4 20h12" stroke-linecap="round" /></svg>
                    </span>
                    <span class="sidebar-label">Dashboard</span>
                </a>
                <a asp-controller="Inventory" asp-action="Index" class="@isActive("Inventory")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M4 6.5L12 3l8 3.5v11L12 21l-8-3.5z" />
                            <path d="M4 6.5L12 10l8-3.5" />
                            <path d="M12 10v11" />
                            <path d="M8 8.5l8-3.5" />
                        </svg>
                    </span>
                    <span class="sidebar-label">Inventory</span>
                </a>
                <a asp-controller="Categories" asp-action="Index" class="@isActive("Categories")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12.5 3H5a1 1 0 0 0-1 1v7.5a1 1 0 0 0 .3.7l9 9a1 1 0 0 0 1.4 0l7.5-7.5a1 1 0 0 0 0-1.4l-9-9a1 1 0 0 0-.7-.3Z" /><circle cx="8.5" cy="8.5" r="1.2" /></svg>
                    </span>
                    <span class="sidebar-label">Categories</span>
                </a>
                <a asp-controller="Products" asp-action="Index" class="@isActive("Products")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 7.5 12 3l8.5 4.5V16.5L12 21l-8.5-4.5Z" /><path d="M3.5 7.5 12 12l8.5-4.5" /><path d="M12 12v9" /></svg>
                    </span>
                    <span class="sidebar-label">Products</span>
                </a>
                <a asp-controller="Suppliers" asp-action="Index" class="@isActive("Suppliers")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 16V6h11v10" /><path d="M13 9h4l4 4v3h-8" /><circle cx="6.5" cy="17.5" r="1.6" /><circle cx="17.5" cy="17.5" r="1.6" /></svg>
                    </span>
                    <span class="sidebar-label">Suppliers</span>
                </a>

                <a asp-controller="Sales" asp-action="Index" class="@isActive("Sales")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h12v18l-2.5-1.5L13 21l-2.5-1.5L8 21l-2-1.5Z" /><path d="M9 8h6M9 12h6" /></svg>
                    </span>
                    <span class="sidebar-label">Sales</span>
                </a>

                <a asp-controller="Purchases" asp-action="Index" class="@isActive("Purchases")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h2l2.4 12.1a1 1 0 0 0 1 .9h8.4a1 1 0 0 0 1-.8L20 8H6" /><circle cx="9.5" cy="20" r="1.2" /><circle cx="17" cy="20" r="1.2" /></svg>
                    </span>
                    <span class="sidebar-label">Purchases</span>
                </a>

                <a asp-controller="Rag" asp-action="Index" class="@isActive("Rag")">
                    <span class="sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v10H8l-4 4Z" /><path d="M8 9h8M8 12h5" /></svg>
                    </span>
                    <span class="sidebar-label">Assistant</span>
                </a>
            </nav>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <h1>@ViewData["Title"]</h1>
            </header>
            <main class="page-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null && ViewData["Title"]?.ToString() != "Delete Product" && ViewData["Title"]?.ToString() != "Delete Category" && ViewData["Title"]?.ToString() != "Delete Supplier")
                {
                    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>