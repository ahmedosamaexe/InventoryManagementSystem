@using System.Text.Json
@model InventoryManagementSystem.ViewModels.DashboardViewModel
@{
    Layout = null;
    var chartLabels = JsonSerializer.Serialize(Model.MostSoldProducts.Select(p => p.ProductName));
    var chartData = JsonSerializer.Serialize(Model.MostSoldProducts.Select(p => p.QuantitySold));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Management Dashboard</title>
    <!-- Tailwind CSS للستايل والألوان -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome للأيقونات -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js للرسوم البيانية -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sidebar: '#1a222c', // لون الشريط الجانبي من الصورة
                        sysGreen: '#6e987c', // لون كلمة Sys من الصورة
                        bgLight: '#f4f6f9'  // لون الخلفية
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-bgLight font-sans flex h-screen overflow-hidden text-gray-800">

    <!-- Sidebar -->
    <aside class="w-64 bg-sidebar text-gray-300 flex flex-col h-full shadow-lg z-10">
        <!-- Logo -->
        <div class="h-16 flex items-center px-6 font-bold text-2xl tracking-wide text-white bg-sidebar border-b border-gray-700/50">
            Inventory<span class="text-sysGreen">Sys</span>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 py-4 overflow-y-auto space-y-1">
            <a asp-controller="Home" asp-action="Index" class="block px-6 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-200">Home</a>
            <a asp-controller="Dashboard" asp-action="Index" class="block px-6 py-3 text-white bg-gray-800/50 border-l-4 border-sysGreen font-medium">Dashboard</a>
            <a asp-controller="Categories" asp-action="Index" class="block px-6 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-200">Categories</a>
            <a asp-controller="Products" asp-action="Index" class="block px-6 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-200">Products</a>
            <a asp-controller="Suppliers" asp-action="Index" class="block px-6 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-200">Suppliers</a>
            <a href="#" title="Coming soon" class="block px-6 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-200">Purchases</a>
            <a href="#" title="Coming soon" class="block px-6 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-200">Sales</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">

        <!-- Top Navbar -->
        <header class="h-16 bg-white shadow-sm flex items-center px-8 border-b border-gray-200 z-0">
            <h1 class="text-xl font-semibold text-gray-700">Dashboard Overview</h1>
        </header>

        <!-- Dashboard Content -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-bgLight p-8">

            <!-- KPI Cards Grid (بيانات حقيقية من الداتابيز) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

                <!-- Total Products -->
                <div class="bg-white rounded-lg shadow-sm p-6 flex items-center border border-gray-100">
                    <div class="p-4 rounded-full bg-blue-100 text-blue-600 mr-4">
                        <i class="fas fa-box fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Products</p>
                        <p class="text-2xl font-bold text-gray-700">@Model.TotalProducts.ToString("N0")</p>
                    </div>
                </div>

                <!-- Total Stock Quantity -->
                <div class="bg-white rounded-lg shadow-sm p-6 flex items-center border border-gray-100">
                    <div class="p-4 rounded-full bg-green-100 text-green-600 mr-4">
                        <i class="fas fa-cubes fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Stock Qty</p>
                        <p class="text-2xl font-bold text-gray-700">@Model.TotalStockQuantity.ToString("N0")</p>
                    </div>
                </div>

                <!-- Low-Stock Alerts -->
                <div class="bg-white rounded-lg shadow-sm p-6 flex items-center border border-red-100">
                    <div class="p-4 rounded-full bg-red-100 text-red-600 mr-4">
                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-sm text-red-500 font-medium">Low-Stock Alerts</p>
                        <p class="text-2xl font-bold text-red-600">@Model.LowStockCount Items</p>
                    </div>
                </div>

                <!-- Total Categories & Suppliers -->
                <div class="bg-white rounded-lg shadow-sm p-6 flex items-center border border-gray-100">
                    <div class="p-4 rounded-full bg-purple-100 text-purple-600 mr-4">
                        <i class="fas fa-tags fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Categories / Suppliers</p>
                        <p class="text-2xl font-bold text-gray-700">@Model.TotalCategories / @Model.TotalSuppliers</p>
                    </div>
                </div>

                <!-- Total Sales (Count & Revenue) -->
                <div class="bg-white rounded-lg shadow-sm p-6 flex items-center border border-gray-100">
                    <div class="p-4 rounded-full bg-emerald-100 text-emerald-600 mr-4">
                        <i class="fas fa-chart-line fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Sales Revenue</p>
                        <p class="text-2xl font-bold text-gray-700">$@Model.TotalSalesRevenue.ToString("N0")</p>
                        <p class="text-xs text-emerald-600 font-medium mt-1">+@Model.TotalSalesCount.ToString("N0") Orders</p>
                    </div>
                </div>

                <!-- Total Purchases (Count & Monetary) -->
                <div class="bg-white rounded-lg shadow-sm p-6 flex items-center border border-gray-100">
                    <div class="p-4 rounded-full bg-orange-100 text-orange-600 mr-4">
                        <i class="fas fa-shopping-cart fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Purchases Cost</p>
                        <p class="text-2xl font-bold text-gray-700">$@Model.TotalPurchasesCost.ToString("N0")</p>
                        <p class="text-xs text-orange-600 font-medium mt-1">+@Model.TotalPurchasesCount.ToString("N0") Orders</p>
                    </div>
                </div>
            </div>

            <!-- Charts and Activity Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <!-- Most Sold Products Chart -->
                <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-100 lg:col-span-1">
                    <h2 class="text-lg font-semibold text-gray-700 mb-4">Most Sold Products</h2>
                    @if (Model.MostSoldProducts.Any())
                    {
                        <canvas id="topProductsChart" height="250"></canvas>
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 py-10 text-center">No sales recorded yet.</p>
                    }
                </div>

                <!-- Recent Activity Log (Sales & Purchases) -->
                <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-100 lg:col-span-2">
                    <h2 class="text-lg font-semibold text-gray-700 mb-4">Recent Activity Log</h2>
                    <div class="overflow-x-auto">
                        @if (Model.RecentActivities.Any())
                        {
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="text-gray-500 text-sm border-b">
                                        <th class="pb-3 font-medium">Date</th>
                                        <th class="pb-3 font-medium">Type</th>
                                        <th class="pb-3 font-medium">Reference / Details</th>
                                        <th class="pb-3 font-medium">Qty/Amount</th>
                                        <th class="pb-3 font-medium">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="text-sm">
                                    @foreach (var a in Model.RecentActivities)
                                    {
                                        <tr class="border-b border-gray-50 hover:bg-gray-50">
                                            <td class="py-3 text-gray-600">@a.Date.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td class="py-3">
                                                @if (a.Type == "Sale")
                                                {
                                                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold">Sale</span>
                                                }
                                                else
                                                {
                                                    <span class="px-2 py-1 bg-orange-100 text-orange-700 rounded text-xs font-semibold">Purchase</span>
                                                }
                                            </td>
                                            <td class="py-3 text-gray-800">@a.Details</td>
                                            <td class="py-3 font-medium text-gray-700">@a.AmountDisplay</td>
                                            <td class="py-3">
                                                @if (a.Type == "Sale")
                                                {
                                                    <span class="text-green-500"><i class="fas fa-check-circle"></i> @a.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="text-blue-500"><i class="fas fa-truck"></i> @a.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-sm text-gray-400 py-6 text-center">No recent sales or purchases.</p>
                        }
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- تهيئة الرسم البياني (Chart.js) ببيانات حقيقية -->
    @if (Model.MostSoldProducts.Any())
    {
        <script>
            const ctx = document.getElementById('topProductsChart').getContext('2d');
            const topProductsChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(chartLabels),
                    datasets: [{
                        label: 'Units Sold',
                        data: @Html.Raw(chartData),
                        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#6366f1', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 20, boxWidth: 12 }
                        }
                    },
                    cutout: '70%'
                }
            });
        </script>
    }
</body>
</html>
