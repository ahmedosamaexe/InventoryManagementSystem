@using System.Text.Json
@model InventoryManagementSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var dailyLabels = JsonSerializer.Serialize(Model.DailySeries.Select(d => d.Label));
    var dailySales = JsonSerializer.Serialize(Model.DailySeries.Select(d => d.Sales));
    var dailyPurchases = JsonSerializer.Serialize(Model.DailySeries.Select(d => d.Purchases));
    var yearLabels = JsonSerializer.Serialize(Model.TopSellingYear.Select(p => p.ProductName));
    var yearData = JsonSerializer.Serialize(Model.TopSellingYear.Select(p => p.QuantitySold));
    var custLabels = JsonSerializer.Serialize(Model.TopCustomers.Select(c => c.Customer));
    var custData = JsonSerializer.Serialize(Model.TopCustomers.Select(c => c.Total));
    var palette = new[] { "#3b82f6", "#10b981", "#f59e0b", "#6366f1", "#ef4444" };
}

<style>
    /* Dashboard-specific styles */
    .dash-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }
    .dash-header h1 {
        font-size: 1.35rem;
        margin: 0;
    }
    .dash-header p {
        margin: 4px 0 0;
        color: var(--ink-soft);
        font-size: 0.9rem;
    }
    .dash-date-form {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }
    .dash-date-form input[type="date"] {
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 6px 10px;
        color: var(--ink);
        font-size: 0.88rem;
        background: var(--surface);
    }
    .dash-date-form span {
        color: var(--ink-soft);
    }
    .dash-date-form button {
        background: var(--sidebar-bg);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 7px 18px;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.15s;
    }
    .dash-date-form button:hover {
        background: #1e2d3d;
    }

    /* KPI Cards */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }
    .kpi-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .kpi-icon.emerald { background: #d1fae5; color: #059669; }
    .kpi-icon.orange  { background: #ffedd5; color: #ea580c; }
    .kpi-icon.blue    { background: #dbeafe; color: #2563eb; }
    .kpi-icon.green   { background: #dcfce7; color: #16a34a; }
    .kpi-label {
        font-size: 0.85rem;
        color: var(--ink-soft);
        font-weight: 500;
        margin-bottom: 4px;
    }
    .kpi-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
    }

    /* Catalog strip */
    .catalog-strip {
        background: var(--sidebar-bg);
        color: #b7c2cc;
        border-radius: 10px;
        padding: 14px 22px;
        margin-bottom: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 28px;
        font-size: 0.88rem;
    }
    .catalog-strip i {
        color: var(--accent);
        margin-right: 6px;
    }
    .catalog-strip i.text-red { color: #f87171; }
    .catalog-strip strong { color: #fff; }

    /* Chart grid */
    .chart-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        margin-bottom: 24px;
    }
    .chart-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 24px;
    }
    .dash-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 20px;
    }
    .dash-card h2 {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 16px;
    }
    .chart-container {
        height: 256px;
        position: relative;
    }

    /* Dashboard tables */
    .dash-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .dash-table th {
        font-size: 0.8rem;
        color: var(--ink-soft);
        font-weight: 500;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }
    .dash-table td {
        padding: 10px 0;
        font-size: 0.88rem;
        border-bottom: 1px solid #f3f4f6;
    }
    .dash-table tbody tr:hover {
        background: var(--bg);
    }
    .dash-table .text-red { color: #dc2626; font-weight: 500; }

    /* Badges */
    .dash-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .dash-badge.sale     { background: #dcfce7; color: #15803d; }
    .dash-badge.purchase { background: #ffedd5; color: #c2410c; }

    .dash-status-sale     { color: #22c55e; }
    .dash-status-purchase { color: #3b82f6; }

    .dash-empty {
        text-align: center;
        color: var(--ink-soft);
        font-size: 0.88rem;
        padding: 28px 0;
    }

    .dash-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }
    .dash-section-header h2 { margin: 0; }
    .dash-section-header a {
        font-size: 0.85rem;
        color: var(--accent);
        font-weight: 500;
        text-decoration: none;
    }
    .dash-section-header a:hover { text-decoration: underline; }

    .dash-full-width {
        margin-bottom: 24px;
    }

    @@media (max-width: 1200px) {
        .chart-grid-3 { grid-template-columns: 1fr; }
    }
    @@media (max-width: 992px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .chart-grid-2 { grid-template-columns: 1fr; }
    }
    @@media (max-width: 576px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>

<!-- Dashboard Header -->
<div class="dash-header">
    <div>
        <p>Welcome back! Here's what's happening.</p>
    </div>
    <form method="get" class="dash-date-form">
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
        <span>-</span>
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
        <button type="submit">Apply</button>
    </form>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon emerald"><i class="fas fa-chart-line"></i></div>
        <div>
            <div class="kpi-label">Total Sales</div>
            <div class="kpi-value">$@Model.SalesTotal.ToString("N2")</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon orange"><i class="fas fa-shopping-cart"></i></div>
        <div>
            <div class="kpi-label">Total Purchases</div>
            <div class="kpi-value">$@Model.PurchasesTotal.ToString("N2")</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon blue"><i class="fas fa-receipt"></i></div>
        <div>
            <div class="kpi-label">Invoice</div>
            <div class="kpi-value">@Model.InvoiceCount.ToString("N0")</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon green"><i class="fas fa-sack-dollar"></i></div>
        <div>
            <div class="kpi-label">Profit</div>
            <div class="kpi-value">$@Model.Profit.ToString("N2")</div>
        </div>
    </div>
</div>

<!-- Catalog Summary Strip -->
<div class="catalog-strip">
    <span><i class="fas fa-box"></i>Total Products: <strong>@Model.TotalProducts.ToString("N0")</strong></span>
    <span><i class="fas fa-tags"></i>Total Categories: <strong>@Model.TotalCategories.ToString("N0")</strong></span>
    <span><i class="fas fa-truck-field"></i>Total Suppliers: <strong>@Model.TotalSuppliers.ToString("N0")</strong></span>
    <span><i class="fas fa-cubes"></i>Total Stock Quantity: <strong>@Model.TotalStockQuantity.ToString("N0")</strong></span>
    <span><i class="fas fa-exclamation-triangle text-red"></i>Low-Stock Products: <strong>@Model.LowStockCount items</strong></span>
</div>

<!-- Sales & Purchases + Payment Sent & Received -->
<div class="chart-grid-2">
    <div class="dash-card">
        <h2>Sales &amp; Purchases</h2>
        <div class="chart-container"><canvas id="salesPurchasesChart"></canvas></div>
    </div>
    <div class="dash-card">
        <h2>Payment Sent &amp; Received</h2>
        <div class="chart-container"><canvas id="paymentsChart"></canvas></div>
    </div>
</div>

<!-- Most Sold (Month) + Most Sold (Year) + Top Customers -->
<div class="chart-grid-3">
    <div class="dash-card">
        <h2>Most Sold Products (@Model.To.ToString("MMMM"))</h2>
        @if (Model.TopSellingMonth.Any())
        {
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Total Sales</th>
                        <th>Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.TopSellingMonth)
                    {
                        <tr>
                            <td>@p.ProductName</td>
                            <td>@p.QuantitySold</td>
                            <td style="font-weight:500;">$@p.Revenue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="dash-empty">No sales this month yet.</p>
        }
    </div>
    <div class="dash-card">
        <h2>Most Sold Products (@Model.To.Year)</h2>
        @if (Model.TopSellingYear.Any())
        {
            <div class="chart-container"><canvas id="topYearChart"></canvas></div>
        }
        else
        {
            <p class="dash-empty">No sales recorded yet.</p>
        }
    </div>
    <div class="dash-card">
        <h2>Top 5 Customers (@Model.To.ToString("MMMM"))</h2>
        @if (Model.TopCustomers.Any())
        {
            <div class="chart-container"><canvas id="topCustomersChart"></canvas></div>
        }
        else
        {
            <p class="dash-empty">No customers yet.</p>
        }
    </div>
</div>

<!-- Recent Activity Log -->
<div class="dash-full-width">
    <div class="dash-card">
        <h2>Recent Activity Log</h2>
        @if (Model.RecentActivities.Any())
        {
            <div style="overflow-x:auto;">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Reference / Details</th>
                            <th>Qty/Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.RecentActivities)
                        {
                            <tr>
                                <td style="color:var(--ink-soft);">@a.Date.ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    @if (a.Type == "Sale")
                                    {
                                        <span class="dash-badge sale">Sale</span>
                                    }
                                    else
                                    {
                                        <span class="dash-badge purchase">Purchase</span>
                                    }
                                </td>
                                <td>@a.Details</td>
                                <td style="font-weight:500;">@a.AmountDisplay</td>
                                <td>
                                    @if (a.Type == "Sale")
                                    {
                                        <span class="dash-status-sale"><i class="fas fa-check-circle"></i> @a.Status</span>
                                    }
                                    else
                                    {
                                        <span class="dash-status-purchase"><i class="fas fa-truck"></i> @a.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="dash-empty">No recent activity yet.</p>
        }
    </div>
</div>

<!-- Stock Alert -->
<div class="dash-full-width">
    <div class="dash-card">
        <div class="dash-section-header">
            <h2>Stock Alert</h2>
            <a asp-controller="Products" asp-action="Index">View All</a>
        </div>
        @if (Model.StockAlerts.Any())
        {
            <div style="overflow-x:auto;">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Product Name</th>
                            <th>Quantity</th>
                            <th>Alert Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StockAlerts)
                        {
                            <tr>
                                <td style="color:var(--ink-soft);">@s.SKU</td>
                                <td>@s.ProductName</td>
                                <td class="text-red">@s.StockQuantity</td>
                                <td style="color:var(--ink-soft);">@s.AlertQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="dash-empty">No stock alerts. All good!</p>
        }
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const palette = @Html.Raw(JsonSerializer.Serialize(palette));
        const chartOpts = (extra) => Object.assign({
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { padding: 20, boxWidth: 12 } } }
        }, extra || {});

        new Chart(document.getElementById('salesPurchasesChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(dailyLabels),
                datasets: [
                    { label: 'Sales', data: @Html.Raw(dailySales), backgroundColor: '#10b981' },
                    { label: 'Purchases', data: @Html.Raw(dailyPurchases), backgroundColor: '#f59e0b' }
                ]
            },
            options: chartOpts({ plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } })
        });

        @if (Model.TopSellingYear.Any())
        {
            <text>
            new Chart(document.getElementById('topYearChart'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(yearLabels),
                    datasets: [{ label: 'Units Sold', data: @Html.Raw(yearData), backgroundColor: palette, borderWidth: 0 }]
                },
                options: chartOpts({ cutout: '70%' })
            });
            </text>
        }

        new Chart(document.getElementById('paymentsChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(dailyLabels),
                datasets: [
                    { label: 'Payment Received', data: @Html.Raw(dailySales), borderColor: '#10b981', backgroundColor: '#10b981', tension: 0.3 },
                    { label: 'Payment Sent', data: @Html.Raw(dailyPurchases), borderColor: '#ef4444', backgroundColor: '#ef4444', tension: 0.3 }
                ]
            },
            options: chartOpts({ plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } })
        });

        @if (Model.TopCustomers.Any())
        {
            <text>
            new Chart(document.getElementById('topCustomersChart'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(custLabels),
                    datasets: [{ label: 'Total', data: @Html.Raw(custData), backgroundColor: palette, borderWidth: 0 }]
                },
                options: chartOpts({ cutout: '70%' })
            });
            </text>
        }
    </script>
}