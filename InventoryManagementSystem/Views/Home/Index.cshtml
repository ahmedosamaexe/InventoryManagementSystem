@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>InventorySys - Smart Inventory Management</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            sysPurple: '#6F4AA8',
                            sysPurpleDark: '#5E3C91',
                            purpleLight: '#F4EFFA',
                            purpleSoft: '#FAF8FC',
                            textPrimary: '#17151A',
                            textSecondary: '#625D68',
                            borderLight: '#E7E1EE'
                        }
                    }
                }
            }
    </script>

    <style>
            body {
                background: #FFFFFF;
                color: #17151A;
            }

            .stat-card {
                background: #FFFFFF;
                border: 1px solid #E7E1EE;
                transition: all 0.2s ease;
            }

                .stat-card:hover {
                    border-color: #D8CBE7;
                    transform: translateY(-2px);
                }

            .feature-card {
                background: #FFFFFF;
                border: 1px solid #E7E1EE;
                transition: all 0.2s ease;
            }

                .feature-card:hover {
                    border-color: #CDBCE0;
                    box-shadow: 0 8px 24px rgba(111, 74, 168, 0.08);
                    transform: translateY(-2px);
                }

            .feature-icon {
                width: 46px;
                height: 46px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #F4EFFA;
                color: #6F4AA8;
                border-radius: 10px;
            }
    </style>


</head>

<body class="font-sans">


    <!-- Navbar -->
    <nav class="bg-white border-b border-borderLight sticky top-0 z-50">

        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

            <!-- Logo -->
            <a asp-controller="Home"
               asp-action="Index"
               class="font-bold text-2xl tracking-tight text-textPrimary">

                Inventory<span class="text-sysPurple">Sys</span>

            </a>

            <!-- Navigation -->
            <div class="hidden md:flex items-center space-x-8 text-sm font-medium">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-sysPurple font-semibold">
                    Home
                </a>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Dashboard
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Products
                </a>

                <a asp-controller="Purchases"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Purchases
                </a>

                <a asp-controller="Suppliers"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Suppliers
                </a>

                <a asp-controller="Rag"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Assistant
                </a>

            </div>

            <!-- Dashboard Button -->
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="bg-sysPurple text-white text-sm font-semibold rounded-lg px-5 py-2.5 hover:bg-sysPurpleDark transition-colors">

                Open Dashboard

            </a>

        </div>

    </nav>


    <!-- Hero -->
    <header class="bg-white">

        <div class="max-w-7xl mx-auto px-6 py-20 md:py-24">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

                <!-- Hero Text -->
                <div>

                    <div class="inline-flex items-center gap-2 bg-purpleLight text-sysPurple rounded-md px-3 py-1.5 mb-6 text-xs font-semibold tracking-wide">

                        <i class="fas fa-layer-group"></i>

                        INVENTORY MANAGEMENT SYSTEM

                    </div>

                    <h1 class="text-4xl md:text-5xl font-bold leading-tight text-textPrimary mb-6">

                        Manage your inventory
                        <span class="text-sysPurple">
                            with confidence.
                        </span>

                    </h1>

                    <p class="text-textSecondary text-lg leading-relaxed max-w-xl mb-8">

                        Keep products, suppliers, purchases and sales organized
                        in one place. Monitor your stock and make better
                        inventory decisions with clear, reliable data.

                    </p>

                    <div class="flex flex-wrap gap-3">

                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="bg-sysPurple text-white font-semibold rounded-lg px-6 py-3 hover:bg-sysPurpleDark transition-colors">

                            <i class="fas fa-chart-line mr-2"></i>

                            Explore Dashboard

                        </a>

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="border border-borderLight text-textPrimary font-semibold rounded-lg px-6 py-3 hover:bg-purpleSoft hover:border-purpleLight transition-colors">

                            <i class="fas fa-box mr-2 text-sysPurple"></i>

                            Browse Products

                        </a>

                    </div>

                </div>


                <!-- Statistics -->
                <div class="grid grid-cols-2 gap-4">

                    <!-- Products -->
                    <div class="stat-card rounded-xl p-6">

                        <div class="flex items-center justify-between mb-5">

                            <div class="feature-icon">
                                <i class="fas fa-box"></i>
                            </div>

                            <span class="text-xs text-textSecondary">
                                Products
                            </span>

                        </div>

                        <p class="text-3xl font-bold text-textPrimary">
                            @ViewBag.TotalProducts
                        </p>

                        <p class="text-sm text-textSecondary mt-1">
                            Total products
                        </p>

                    </div>


                    <!-- Categories -->
                    <div class="stat-card rounded-xl p-6">

                        <div class="flex items-center justify-between mb-5">

                            <div class="feature-icon">
                                <i class="fas fa-tags"></i>
                            </div>

                            <span class="text-xs text-textSecondary">
                                Categories
                            </span>

                        </div>

                        <p class="text-3xl font-bold text-textPrimary">
                            @ViewBag.TotalCategories
                        </p>

                        <p class="text-sm text-textSecondary mt-1">
                            Product categories
                        </p>

                    </div>


                    <!-- Suppliers -->
                    <div class="stat-card rounded-xl p-6">

                        <div class="flex items-center justify-between mb-5">

                            <div class="feature-icon">
                                <i class="fas fa-truck"></i>
                            </div>

                            <span class="text-xs text-textSecondary">
                                Suppliers
                            </span>

                        </div>

                        <p class="text-3xl font-bold text-textPrimary">
                            @ViewBag.TotalSuppliers
                        </p>

                        <p class="text-sm text-textSecondary mt-1">
                            Active suppliers
                        </p>

                    </div>


                    <!-- Sales -->
                    <div class="stat-card rounded-xl p-6">

                        <div class="flex items-center justify-between mb-5">

                            <div class="feature-icon">
                                <i class="fas fa-receipt"></i>
                            </div>

                            <span class="text-xs text-textSecondary">
                                Sales
                            </span>

                        </div>

                        <p class="text-3xl font-bold text-textPrimary">
                            @ViewBag.TotalSales
                        </p>

                        <p class="text-sm text-textSecondary mt-1">
                            Sales orders
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </header>


    <!-- Features -->
    <main class="bg-purpleSoft border-t border-borderLight">

        <div class="max-w-7xl mx-auto px-6 py-20">

            <div class="max-w-2xl mb-12">

                <p class="text-xs font-semibold tracking-widest text-sysPurple uppercase mb-3">
                    Core capabilities
                </p>

                <h2 class="text-3xl font-bold text-textPrimary mb-3">
                    Everything you need to manage your stock
                </h2>

                <p class="text-textSecondary">
                    Practical tools designed to keep your inventory organized,
                    accurate and easy to monitor.
                </p>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">


                <!-- Product Management -->
                <div class="feature-card rounded-xl p-6">

                    <div class="feature-icon mb-5">
                        <i class="fas fa-box"></i>
                    </div>

                    <h3 class="font-semibold text-textPrimary text-lg mb-2">
                        Product Management
                    </h3>

                    <p class="text-sm text-textSecondary leading-relaxed">
                        Add, edit and organize products with SKU, pricing,
                        stock levels and categories.
                    </p>

                </div>


                <!-- Purchases -->
                <div class="feature-card rounded-xl p-6">

                    <div class="feature-icon mb-5">
                        <i class="fas fa-cart-shopping"></i>
                    </div>

                    <h3 class="font-semibold text-textPrimary text-lg mb-2">
                        Purchases
                    </h3>

                    <p class="text-sm text-textSecondary leading-relaxed">
                        Record supplier purchases and keep stock quantities
                        updated automatically.
                    </p>

                </div>


                <!-- Sales -->
                <div class="feature-card rounded-xl p-6">

                    <div class="feature-icon mb-5">
                        <i class="fas fa-chart-line"></i>
                    </div>

                    <h3 class="font-semibold text-textPrimary text-lg mb-2">
                        Sales Tracking
                    </h3>

                    <p class="text-sm text-textSecondary leading-relaxed">
                        Create sales orders with automatic stock deduction
                        and accurate totals.
                    </p>

                </div>


                <!-- Inventory -->
                <div class="feature-card rounded-xl p-6">

                    <div class="feature-icon mb-5">
                        <i class="fas fa-warehouse"></i>
                    </div>

                    <h3 class="font-semibold text-textPrimary text-lg mb-2">
                        Inventory Control
                    </h3>

                    <p class="text-sm text-textSecondary leading-relaxed">
                        Monitor current stock levels and quickly identify
                        products that need attention.
                    </p>

                </div>


                <!-- Suppliers -->
                <div class="feature-card rounded-xl p-6">

                    <div class="feature-icon mb-5">
                        <i class="fas fa-truck"></i>
                    </div>

                    <h3 class="font-semibold text-textPrimary text-lg mb-2">
                        Supplier Profiles
                    </h3>

                    <p class="text-sm text-textSecondary leading-relaxed">
                        Manage supplier information and keep track of the
                        products they provide.
                    </p>

                </div>


                <!-- Assistant -->
                <div class="feature-card rounded-xl p-6">

                    <div class="feature-icon mb-5">
                        <i class="fas fa-wand-magic-sparkles"></i>
                    </div>

                    <h3 class="font-semibold text-textPrimary text-lg mb-2">
                        Inventory Assistant
                    </h3>

                    <p class="text-sm text-textSecondary leading-relaxed">
                        Get useful insights and assistance when reviewing
                        inventory information.
                    </p>

                </div>

            </div>

        </div>

    </main>


    <!-- CTA -->
    <section class="bg-white border-t border-borderLight">

        <div class="max-w-7xl mx-auto px-6 py-16">

            <div class="bg-sysPurple rounded-2xl px-8 py-12 md:px-14 text-center">

                <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
                    Ready to take control of your inventory?
                </h2>

                <p class="text-purple-100 mb-8 max-w-xl mx-auto">
                    Open your dashboard and get a clear view of your
                    inventory at a glance.
                </p>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="inline-flex items-center bg-white text-sysPurple font-semibold rounded-lg px-7 py-3 hover:bg-purpleSoft transition-colors">

                    Go to Dashboard

                    <i class="fas fa-arrow-right ml-2"></i>

                </a>

            </div>

        </div>

    </section>


    <!-- Footer -->
    <footer class="bg-white border-t border-borderLight">

        <div class="max-w-7xl mx-auto px-6 py-7 flex flex-col md:flex-row items-center justify-between gap-4">

            <span class="font-bold text-lg text-textPrimary">
                Inventory<span class="text-sysPurple">Sys</span>
            </span>

            <div class="flex items-center space-x-6 text-sm">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Dashboard
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Products
                </a>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="text-textSecondary hover:text-sysPurple transition-colors">
                    Categories
                </a>

            </div>

        </div>

    </footer>


</body>
</html>
