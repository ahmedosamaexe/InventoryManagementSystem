@model Category
@{
    ViewData["Title"] = "Category Details";
}

<div class="panel p-4 mb-4" style="max-width:560px">
    <h4 class="mb-1">@Model.CategoryName</h4>
    <p class="text-muted mb-0">@(Model.Description ?? "No description")</p>
</div>

<h5 class="mb-3">Products in this category (@Model.Products.Count)</h5>

<div class="panel mb-4">
    @if (!Model.Products.Any())
    {
        <div class="empty-state">No products in this category.</div>
    }
    else
    {
        <table class="table-clean">
            <thead>
                <tr><th>Product</th><th>SKU</th><th>Stock</th><th>Price</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td>@p.ProductName</td>
                        <td class="text-muted">@p.SKU</td>
                        <td>@p.StockQuantity</td>
                        <td>@p.UnitPrice.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-outline-accent">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>