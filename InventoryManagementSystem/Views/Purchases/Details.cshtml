@model InventoryManagementSystem.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<h1>Purchase #@Model.PurchaseId</h1>

<dl class="row">
    <dt class="col-sm-2">Supplier</dt>
    <dd class="col-sm-10">@Model.Supplier?.SupplierName</dd>

    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.PurchaseDate.ToString("g")</dd>

    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
</dl>

<h3>Items</h3>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Cost</th>
            <th>Line Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.PurchaseItems)
        {
            <tr>
                <td>@item.Product?.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitCost.ToString("C")</td>
                <td>@((item.Quantity * item.UnitCost).ToString("C"))</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index">Back to list</a>
