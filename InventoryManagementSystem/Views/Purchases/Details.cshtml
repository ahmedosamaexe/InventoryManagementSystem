@model InventoryManagementSystem.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<div class="panel p-4 mb-4" style="max-width:680px">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h4 class="mb-1">Purchase #@Model.PurchaseId</h4>
            <p class="text-muted mb-0">@Model.PurchaseDate.ToString("dd MMM yyyy, HH:mm")</p>
        </div>
        <span class="badge badge-soft-accent">@Model.TotalAmount.ToString("N2")</span>
    </div>

    <hr />

    <div class="mb-3">
        <div class="text-muted small">Supplier</div>
        <div>@Model.Supplier?.SupplierName</div>
    </div>

    <table class="table-clean">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Cost</th>
                <th>Line Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PurchaseItems)
            {
                <tr>
                    <td>@item.Product?.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitCost.ToString("N2")</td>
                    <td>@((item.Quantity * item.UnitCost).ToString("N2"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
