@model InventoryManagementSystem.ViewModels.PurchaseCreateViewModel
@{
    ViewData["Title"] = "New Purchase";
    var suppliers = (List<InventoryManagementSystem.Models.Supplier>)ViewBag.Suppliers;
    var products = (List<InventoryManagementSystem.Models.Product>)ViewBag.Products;
}

<div class="sale-form-panel">
    <form asp-action="Create" method="post" id="purchaseForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Supplier</label>
            <select name="SupplierId" id="supplierSelect" class="form-select" required>
                <option value="">-- Select Supplier --</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.SupplierId">@s.SupplierName</option>
                }
            </select>
            <span class="text-muted small" id="supplierHint"></span>
        </div>


        <div class="sale-items-header">
            <h3>Items</h3>
            <button type="button" id="addRowBtn" class="btn btn-sm btn-outline-accent">+ Add Product</button>
        </div>

        <table class="table-clean" id="itemsTable">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Cost</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <!-- rows are added here by JS -->
            </tbody>
        </table>

        <div class="purchase-total">
            <strong>Total:</strong>
            <span id="purchaseTotal">0.00</span>
        </div>


        <div class="mt-4">
            <button type="submit" class="btn btn-accent">Save Purchase</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

<!-- Template for a product select (full catalog, used before a supplier is picked) -->
<script id="productOptionsTemplate" type="text/template">
    @foreach (var p in products)
    {
        <text><option value="@p.ProductId">@p.ProductName (@p.UnitPrice.ToString("C"))</option></text>
    }
</script>

<script>
    let rowIndex = 0;
    const fallbackProductOptionsHtml = document.getElementById('productOptionsTemplate').innerHTML;
    let productOptionsHtml = fallbackProductOptionsHtml;

    function formatCurrency(v) {
        return '$' + Number(v).toFixed(2);
    }

    function refreshAllProductSelects() {
        document.querySelectorAll('#itemsTable tbody select').forEach(select => {
            const currentValue = select.value;
            select.innerHTML = '<option value="">-- Select Product --</option>' + productOptionsHtml;
            if ([...select.options].some(o => o.value === currentValue)) {
                select.value = currentValue;
            }
        });
    }

    document.getElementById('supplierSelect').addEventListener('change', function () {
        const supplierId = this.value;
        const hint = document.getElementById('supplierHint');

        if (!supplierId) {
            productOptionsHtml = fallbackProductOptionsHtml;
            hint.textContent = '';
            refreshAllProductSelects();
            return;
        }

        hint.textContent = 'Loading products for this supplier...';

        fetch(`/Purchases/ProductsBySupplier?supplierId=${supplierId}`)
            .then(res => res.json())
            .then(data => {
                productOptionsHtml = data
                    .map(p => `<option value="${p.id}">${p.name} (${formatCurrency(p.price)})</option>`)
                    .join('');
                hint.textContent = `${data.length} product(s) available from this supplier`;
                refreshAllProductSelects();
            })
            .catch(() => {
                hint.textContent = 'Could not load supplier products, showing full catalog instead.';
                productOptionsHtml = fallbackProductOptionsHtml;
                refreshAllProductSelects();
            });
    });

    function updatePurchaseTotal() {
        let total = 0;

        document.querySelectorAll('#itemsTable tbody tr').forEach(row => {
            const quantityInput = row.querySelector('.qty-input');
            const costInput = row.querySelector('.cost-input');

            const quantity = Number(quantityInput?.value) || 0;
            const unitCost = Number(costInput?.value) || 0;

            total += quantity * unitCost;
        });

        document.getElementById('purchaseTotal').textContent =
            total.toFixed(2);
    }

    function addRow() {
        const tbody = document.querySelector('#itemsTable tbody');
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <select name="Items[${rowIndex}].ProductId" class="form-select" required>
                    <option value="">-- Select Product --</option>
                    ${productOptionsHtml}
                </select>
            </td>
            <td>
                <input type="number" name="Items[${rowIndex}].Quantity" min="1" class="form-control qty-input" required />
                <span class="text-danger error-msg" style="display:none;">Quantity must be greater than 0</span>
            </td>
            <td>
                <input type="number" step="0.01" name="Items[${rowIndex}].UnitCost" min="0.01" class="form-control cost-input" required />
                <span class="text-danger error-msg" style="display:none;">Unit cost must be greater than 0</span>
            </td>
            <td>
                <button type="button" class="btn btn-outline-danger btn-sm remove-row">Remove</button>
            </td>
        `;
        tbody.appendChild(row);
        row.querySelector('.qty-input')
            .addEventListener('input', updatePurchaseTotal);

        row.querySelector('.cost-input')
            .addEventListener('input', updatePurchaseTotal);

        updatePurchaseTotal();

        rowIndex++;
    }

    document.getElementById('addRowBtn').addEventListener('click', addRow);

    // Remove row
    document.querySelector('#itemsTable tbody').addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-row')) {
            e.target.closest('tr').remove();
            updatePurchaseTotal();
        }
    });

    // Client-side validation: quantity and unit cost must be positive numbers
    document.getElementById('purchaseForm').addEventListener('submit', function (e) {
        let valid = true;
        document.querySelectorAll('.qty-input').forEach(input => {
            const errorSpan = input.nextElementSibling;
            if (!input.value || Number(input.value) <= 0) {
                errorSpan.style.display = 'inline';
                valid = false;
            } else {
                errorSpan.style.display = 'none';
            }
        });

        document.querySelectorAll('.cost-input').forEach(input => {
            const errorSpan = input.nextElementSibling;
            if (!input.value || Number(input.value) <= 0) {
                errorSpan.style.display = 'inline';
                valid = false;
            } else {
                errorSpan.style.display = 'none';
            }
        });

        if (document.querySelectorAll('#itemsTable tbody tr').length === 0) {
            alert('Add at least one product before saving.');
            valid = false;
        }

        if (!valid) e.preventDefault();
    });

    // Start with one row by default
    addRow();
</script>