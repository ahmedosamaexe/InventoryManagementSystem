@model InventoryManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="suppliers-page">

    <div class="suppliers-header">
        <div class="suppliers-header-info">
            <h2>Add Supplier</h2>
            <p>Add a new supplier to your inventory system.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-accent">
            Back to Suppliers
        </a>
    </div>


    <div class="supplier-form-panel">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>



            <div class="supplier-form-group">

                <label asp-for="SupplierName"></label>

                <input asp-for="SupplierName"
                       class="form-control"
                       placeholder="Enter supplier name" />

                <span asp-validation-for="SupplierName"
                      class="supplier-validation">
                </span>

            </div>



            <div class="supplier-form-group">

                <label asp-for="ContactName"></label>

                <input asp-for="ContactName"
                       class="form-control"
                       placeholder="Enter contact person name" />

                <span asp-validation-for="ContactName"
                      class="supplier-validation">
                </span>

            </div>



            <div class="supplier-form-group">

                <label asp-for="Phone"></label>

                <input asp-for="Phone"
                       type="tel"
                       class="form-control"
                       placeholder="Enter phone number" />

                <span asp-validation-for="Phone"
                      class="supplier-validation">
                </span>

            </div>

            <div class="supplier-form-group">

                <label asp-for="Email"></label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="Enter email address" />
                <span asp-validation-for="Email"
                      class="supplier-validation">
                </span>

            </div>



            <div class="supplier-form-group">

                <label asp-for="Address"></label>

                <textarea asp-for="Address"
                          class="form-control"
                          rows="3"
                          placeholder="Enter supplier address"></textarea>

                <span asp-validation-for="Address"
                      class="supplier-validation">
                </span>

            </div>


            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-accent">
                    Add Supplier
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {

            const form = $("form");

            form.find("input, textarea").on("input blur", function() {

                $(this).valid();

            });

        });
    </script>
}