@model IEnumerable<InventoryManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="suppliers-page">

    <div class="suppliers-count-row">
        <span>Total Suppliers: @Model.Count()</span>

        <a asp-action="Create" class="btn btn-accent">
            + Add Supplier
        </a>
    </div>

    <div class="panel">

        @if (!Model.Any())
        {
            <div class="suppliers-empty">
                <p>No suppliers added yet.</p>
            </div>
        }
        else
        {
            <table class="table-clean suppliers-table">

                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Contact</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>
                                <span class="supplier-name">
                                    @supplier.SupplierName
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.ContactName)
                                    ? "—"
                                    : supplier.ContactName)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.Phone)
                                    ? "—"
                                    : supplier.Phone)
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(supplier.Email))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <a href="mailto:@supplier.Email"
                                       class="supplier-email">
                                        @supplier.Email
                                    </a>
                                }
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.Address)
                                    ? "—"
                                    : supplier.Address)
                            </td>

                            <td class="supplier-actions">

                                <a asp-action="Details"
                                   asp-route-id="@supplier.SupplierId"
                                   class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@supplier.SupplierId"
                                   class="btn btn-sm btn-outline-accent">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@supplier.SupplierId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>

</div>